#include "arduino_secrets.h"            // Wifi + things secret values stored

#include <FTDebouncer.h>


#define LGFX_AUTODETECT  
#include <LovyanGFX.hpp>

int w; // variable for screen width
int h; // variable for screen height

 int pad= 20;
 int topbarHeight=90;

//#define USE_MKR_IOT_CARRIER
#define USE_M5STACK_PAPER

#ifdef USE_MKR_IOT_CARRIER

#define PIN_PREV 3
#define PIN_PRESS 4
#define PIN_NEXT 5
#include <Arduino_MKRIoTCarrier.h>
MKRIoTCarrier carrier;

#elif defined(USE_M5STACK_PAPER)

LGFX gfx;

#define PIN_PREV 37
#define PIN_PRESS 38
#define PIN_NEXT 39

#endif

#include "thingProperties.h"

FTDebouncer deb;

unsigned long cntr = 0;
unsigned long lastTickTime;

void setup() {
  // Initialize serial and wait for port to open:
  Serial.begin(115200);
  while(!Serial && millis() < 5000){
    // wait for Serial or TimeOut
  }

  Serial.println("starting setup");
  
  /*  FT Debouncer detects button clicks and triggers callbacks
      onPinActivated(int _pin);
      onPinDeactivated(int _pin);
  */
  deb.addPin(PIN_PREV, HIGH, INPUT_PULLUP); // previous
  deb.addPin(PIN_PRESS, HIGH, INPUT_PULLUP); // press
  deb.addPin(PIN_NEXT, HIGH, INPUT_PULLUP); // next
  deb.begin();
  
  initProperties();

  /* initialise Arduino IoT Cloud instance */
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  
  /* add CallBacks for IoT Cloud events */
  ArduinoCloud.addCallback(ArduinoIoTCloudEvent::CONNECT, doThisOnConnect);
  ArduinoCloud.addCallback(ArduinoIoTCloudEvent::SYNC, doThisOnSync);
  ArduinoCloud.addCallback(ArduinoIoTCloudEvent::DISCONNECT, doThisOnDisconnect);

  /*
     The following function allows you to obtain more information
     related to the state of network and IoT Cloud connection and errors
     the higher number the more granular information you’ll get.
     The default is 0 (only errors).
     Maximum is 4
 */
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();
  delay(500);

/* Initialise MKR IoT Carrier */

#ifdef USE_MKR_IOT_CARRIER
  CARRIER_CASE = false;
  carrier.begin();
  carrier.display.setRotation(0);
  delay(1500);
#endif

/* Initialise M5 Stack Paper */
#ifdef USE_M5STACK_PAPER
  M5.begin();
  M5.RTC.begin();
  M5.SHT30.Begin();

  gfx.init();
  gfx.setRotation(1);                         // Rotate 90 degrees clockwise from 0 to 3. 4 to 7 are upside down.
  w = gfx.width();
  h = gfx.height();
  gfx.setEpdMode(epd_mode_t::epd_quality);    // High quality update, black and white inversion happens for a moment

  // * To be precise, it is a mechanism that is reflected on the screen only when display () is called.
// We have prepared a mechanism to call display () at the timing of SPI bus release, and it is enabled by default.
// By this mechanism, it is automatically reflected on the screen immediately after calling the drawing function or endWrite.
// You can enable / disable this automatic display call with setAutoDisplay (bool).

  //gfx.setAutoDisplay(true); 
  
//  canvas.drawString("Hello, Meeting Room", 10, 10);

#endif

  lastTickTime = millis();


}

void loop() {
  deb.update();
  ArduinoCloud.update();
}


   
void onPinActivated(int _pinNr){
  Serial.print("Pressed: ");
  Serial.println(_pinNr);
}

void onPinDeactivated(int _pinNr){
  Serial.print("Released: ");
  Serial.println(_pinNr);
}


void doThisOnConnect(){
  Serial.println("IoT Cloud Device Connected");
}

void doThisOnSync(){
  Serial.println("IoT Cloud Device Synced");
  displayUpdate();
}

void doThisOnDisconnect(){
  Serial.println("IoT Cloud Device Disconnected");
    gfx.fillScreen(TFT_WHITE);
    displayDisconnected();
}

